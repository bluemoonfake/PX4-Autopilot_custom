#!/bin/sh
#
# @name Generic Antenna Tracker SITL
# @type Antenna Tracker
# @class Rover
# @output Servo1 yaw servo
# @output Servo2 pitch servo
#

PX4_SIMULATOR=${PX4_SIMULATOR:=sihsim}
# Tracker SITL does not need a vehicle dynamics simulator.

set VEHICLE_TYPE antenna_tracker
# This is a ground tracker, not a flight vehicle. Keep it out of mc/fw/rover
# app startup paths and only run the tracker module below.

# MAV_TYPE 5 = ANTENNA_TRACKER in MAVLink enum.
param set-default MAV_TYPE 5
param set-default EKF2_MAG_TYPE 1

# Enable simulated estimator inputs for tracker SITL.
param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1

# Keep tracker outputs available while bench-testing.
param set-default COM_DISARM_LAND -1
param set-default COM_DISARM_PRFLT -1

# Tracker default parameters.
param set-default TRK_MODE 0
param set-default TRK_SERVO_TEST 0
param set-default TRK_YAW_P 1.0
param set-default TRK_PIT_P 1.0

# Antenna tracker servo output mapping.
# Servo1 reads actuator_servos.control[0] for yaw.
# Servo2 reads actuator_servos.control[1] for pitch.
param set-default PWM_MAIN_FUNC1 201
param set-default PWM_MAIN_FUNC2 202

# Start the antenna tracker module.
antenna_tracker start
